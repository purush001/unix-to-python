# Script Modernizer - environment variables.
# Copy to .env.local for local development. On Vercel set these in Project Settings →
# Environment Variables, per environment. Mark every secret as type "Secret" (sensitive).
# NO secret may use the NEXT_PUBLIC_ prefix. Preview deployments run on mocks by default.

# ---- Secrets (read only through getSecret() in src/config/env.ts) --------------------
APP_ACCESS_TOKEN=change-me-long-random-string        # shared access token for the API (put the app behind SSO as well)
CRON_SECRET=change-me-at-least-16-characters          # Vercel Cron sends it as "Authorization: Bearer ..."
ANTHROPIC_API_KEY=                                    # needed when LLM_PROVIDER=anthropic
GITHUB_TOKEN=                                         # needed when GITHUB_PROVIDER=github (contents: read/write on the repo)
POSTGRES_URL=                                         # Supabase POOLED connection string (port 6543); synced by the Vercel integration
CHROMA_API_KEY=                                       # needed when MEMORY_PROVIDER=chroma
VOYAGE_API_KEY=                                       # needed when EMBEDDINGS_PROVIDER=voyage
SMTP_USER=
SMTP_PASSWORD=

# ---- Provider selection: mock (default) or real ---------------------------------------
LLM_PROVIDER=mock            # mock | anthropic
LLM_MODEL=claude-opus-5-5
GITHUB_PROVIDER=mock         # mock | github
STORAGE_PROVIDER=mock        # mock | supabase
MEMORY_PROVIDER=mock         # mock | chroma
EMBEDDINGS_PROVIDER=mock     # mock | voyage
SMTP_PROVIDER=mock           # mock | smtp

# ---- GitHub save ------------------------------------------------------------------------
GITHUB_REPO=owner/name
GITHUB_DATA_BRANCH=conversions-data   # must differ from the deployed branch
DEPLOY_BRANCH=                        # optional; VERCEL_GIT_COMMIT_REF is used on Vercel

# ---- Chroma Cloud (use a separate database for preview and production) --------------------
CHROMA_TENANT=
CHROMA_DATABASE=

# ---- Embeddings ---------------------------------------------------------------------------
EMBEDDINGS_MODEL=voyage-code-4
EMBEDDINGS_BASE_URL=https://ai.mongodb.com/v1

# ---- SMTP (operator notifications sent by the app) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=ops@script.com
OPS_EMAIL=ops@script.com

# ---- Limits ---------------------------------------------------------------------------------
MAX_INPUT_BYTES=204800        # 200 KB
MAX_INPUT_LINES=5000
MAX_REPAIR_ATTEMPTS=2
PROVIDER_TIMEOUT_MS=60000     # per provider call
REQUEST_BUDGET_MS=240000      # pipeline work per request; must stay below the function maxDuration
RETRY_BASE_MS=400
RATE_LIMIT_PER_MINUTE=20      # convert/revise/resume per token; other routes get 10x
LOG_RETENTION_DAYS=14
CRON_BATCH_SIZE=2             # candidate rules verified per cron run

# ---- Optional ---------------------------------------------------------------------------------
DENYLIST_PATH=                # server-side file: one name or term per line. Never commit it.
EVAL_REAL_PROVIDER=           # set to 1 to run `npm run eval` against the configured LLM provider
MOCK_GITHUB_FAILURES=0        # mock only: fail the first N saves (tests the Retry path)
